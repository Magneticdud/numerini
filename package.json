{
  "name": "numerini",
  "version": "0.1.0",
  "description": "Queue management system for shops — GPL-3.0",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "npm run build:main && npm run build:renderer && npm run copy:assets",
    "build:main": "webpack --config webpack.main.config.js",
    "build:renderer": "webpack --config webpack.renderer.config.js",
    "copy:assets": "cp -r src/server dist/ && cp -r locales dist/",
    "start": "npm run build && electron .",
    "dev": "concurrently \"webpack --config webpack.main.config.js --watch\" \"webpack --config webpack.renderer.config.js --watch\"",
    "package": "electron-builder --linux deb"
  },
  "build": {
    "appId": "it.numerini.app",
    "productName": "Numerini",
    "linux": {
      "target": [
        "deb"
      ],
      "category": "Utility"
    },
    "files": [
      "dist/**/*",
      "locales/**/*",
      "public/**/*"
    ],
    "extraResources": [
      {
        "from": "locales",
        "to": "locales"
      },
      {
        "from": "public",
        "to": "public"
      }
    ]
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "express": "^4.19.2",
    "i18next": "^23.11.5",
    "jimp": "^0.22.12",
    "node-cron": "^4.2.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^14.1.2",
    "ws": "^8.17.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.2",
    "@types/node-cron": "^3.0.11",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.11",
    "concurrently": "^8.2.2",
    "css-loader": "^7.1.2",
    "electron": "^39.8.5",
    "electron-builder": "^24.13.3",
    "html-webpack-plugin": "^5.6.0",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.4.5",
    "webpack": "^5.92.1",
    "webpack-cli": "^5.1.4"
  },
  "license": "GPL-3.0"
}
