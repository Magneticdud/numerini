{
  "name": "numerini",
  "version": "0.2.0.2",
  "description": "Queue management system for shops — GPL-3.0",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "npm run build:main && npm run build:renderer && npm run copy:assets",
    "build:main": "webpack --config webpack.main.config.js",
    "build:renderer": "webpack --config webpack.renderer.config.js",
    "copy:assets": "cp -r src/server dist/ && cp -r locales dist/",
    "start": "npm run build && electron-rebuild -f -w better-sqlite3 && electron .",
    "dev": "concurrently \"webpack --config webpack.main.config.js --watch\" \"webpack --config webpack.renderer.config.js --watch\"",
    "package": "electron-builder --linux deb",
    "test": "vitest run"
  },
  "build": {
    "appId": "it.numerini.app",
    "productName": "Numerini",
    "linux": {
      "target": [
        "deb"
      ],
      "category": "Utility"
    },
    "files": [
      "dist/**/*",
      "locales/**/*",
      "public/**/*"
    ],
    "extraResources": [
      {
        "from": "locales",
        "to": "locales"
      },
      {
        "from": "public",
        "to": "public"
      }
    ]
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "i18next": "^26.3.0",
    "jimp": "^1.6.1",
    "node-cron": "^4.2.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-i18next": "^17.0.8",
    "ws": "^8.17.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "@types/node-cron": "^3.0.11",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.0",
    "@types/ws": "^8.5.11",
    "concurrently": "^10.0.1",
    "css-loader": "^7.1.2",
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1",
    "html-webpack-plugin": "^5.6.0",
    "style-loader": "^4.0.0",
    "supertest": "^7.2.2",
    "ts-loader": "^9.6.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "webpack": "^5.92.1",
    "webpack-cli": "^7.0.3"
  },
  "license": "GPL-3.0"
}
